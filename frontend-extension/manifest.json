{
  "manifest_version": 3,
  "name": "kshemOS Citizen Digital Safety Guardian",
  "version": "1.0.0",
  "description": "Real-time browser shield against fake bank lookalikes, credential harvesting, and Aadhaar OTP phishing backed by kshemOS Threat Mesh & Takedown Engine.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "kshemOS Citizen Digital Safety Guardian"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kshemos_takedown_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "takeover.html",
        "shield_icon.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
